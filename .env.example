# Copie este arquivo para .env e preencha os valores localmente.
# Nunca versione o arquivo .env nem valores reais de chaves.

# --- Aplicação ---
APP_NAME=task-organizer
LOG_LEVEL=INFO

# Limite máximo de caracteres aceito em request_text (ver contrato da API).
TASK_REQUEST_MAX_LENGTH=4000
DATABASE_PATH=data/tasks.db

# --- Provedor de IA ---
# Cliente genérico compatível com OpenAI. Troque base URL, modelo e chave
# para usar outro provedor (OpenAI, Groq, OpenRouter, Ollama etc.).
# Google Gemini usa o endpoint compatível com OpenAI abaixo.
AI_PROVIDER=google
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash
AI_API_KEY=sua-chave-aqui
AI_TIMEOUT_SECONDS=90
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.0

# Google Gemini: manter false caso o endpoint compatível não aceite
# response_format. Em provedores que suportam JSON mode, use true.
AI_JSON_MODE=false
